# Reuse the GPU-validated Wan/LTX runtime and isolated SkyReels environment.
# Branch validation never changes the production :latest tag.
FROM ghcr.io/voekee/ugc-factory@sha256:4dcb299fc9154c4f46f5701eff036a7441d7ebcd777a5b2431118c7093db4034
WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY static ./static
COPY scripts ./scripts
CMD ["uvicorn","app.main:app","--host","0.0.0.0","--port","8000","--workers","1"]

# Validate inherited environments on CPU; no GPU-time installs or weight downloads.
RUN /opt/wan-venv/bin/python -c "from diffusers import WanImageToVideoPipeline, AutoencoderKLWan; import torch; assert not torch.cuda.is_available()" \
    && PYTHONPATH=/opt/ugc-models/SkyReels-Reference /opt/skyreels-venv/bin/python -c "from skyreels_v3.pipelines import ReferenceToVideoPipeline; import torch; assert not torch.cuda.is_available()"
RUN /opt/wan-venv/bin/python /app/scripts/check_wan_lightning.py
