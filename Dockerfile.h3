# Separate from the existing LTX image. No model checkpoints are baked into it.
# Candidate image: must be built and GPU-smoke-tested before production rollout.
# Official Linux amd64 CUDA 13 runtime, source cae69be584b8fc2daf0b03ec552710592f8738cb.
FROM lmsysorg/sglang@sha256:5ebce9bbfe8299f3d62c0a2984b399061de4182d5aaac3ec071b0b65155b5150
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 H3_MODEL_PATH=/runpod-volume/models/MiniMax-H3 \
    UGC_RENDERER_MODE=real DATA_DIR=/workspace/ugc-factory-data
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt /tmp/ugc-requirements.txt
# Reuse the official compiled stack, including its Rust modules and Torch/CUDA.
# Extras are installed for this exact SGLang version, not a floating upgrade.
RUN python -c 'from importlib.metadata import version; from pathlib import Path; Path("/tmp/h3-runtime.txt").write_text("\n".join(("sglang[diffusion]==" + version("sglang"), *(name + "==" + version(name) for name in ("torch", "torchvision", "torchaudio")))) + "\n")' \
    && python -m pip install --no-cache-dir -r /tmp/ugc-requirements.txt -r /tmp/h3-runtime.txt
COPY app ./app
COPY static ./static
COPY scripts/serve_h3.py ./scripts/serve_h3.py
RUN python -m compileall -q app scripts \
    && python -m pip check \
    && python -c 'import torch, sglang; from pathlib import Path; assert (Path(sglang.__file__).parent / "multimodal_gen/runtime/pipelines/minimax_h3_pipeline.py").is_file(); print("H3 candidate CPU import check:", torch.__version__, torch.version.cuda); assert not torch.cuda.is_available()'
LABEL org.ugc-factory.sglang-revision="cae69be584b8fc2daf0b03ec552710592f8738cb"
EXPOSE 8000
CMD ["python", "-m", "scripts.serve_h3"]
